{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo-refiner.local/schema/node-graph-v1.json",
  "title": "Photo Refiner Node Graph v1",
  "type": "object",
  "required": ["version","graphId","nodes","edges"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "graphId": {"type":"string","minLength":1,"maxLength":120},
    "createdFrom": {"type":"string","enum":["legacy-config","node-canvas","manual"]},
    "nodes": {
      "type":"array","minItems":4,"maxItems":6,
      "items":{
        "type":"object","required":["id","type","enabled","config"],"additionalProperties":false,
        "properties":{
          "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
          "type":{"enum":["source","look","creative-effect","approval","recovery","delivery"]},
          "enabled":{"type":"boolean"},
          "config":{"type":"object"},
          "position":{"type":"object","required":["x","y"],"additionalProperties":false,"properties":{"x":{"type":"number"},"y":{"type":"number"}}}
        }
      }
    },
    "edges": {
      "type":"array","minItems":3,"maxItems":7,
      "items":{
        "type":"object","required":["from","to"],"additionalProperties":false,
        "properties":{"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},"kind":{"type":"string","enum":["flow","reference"]}}
      }
    },
    "metadata":{"type":"object"}
  }
}
